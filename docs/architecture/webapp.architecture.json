  "cards": [
    { "dot": "cyan", "title": "Two clocks, one screen", "items": ["Tide and wave queries run in parallel, gated until apiKey and location hydrate from storage", "A background refresh tops up any cache hit landed over an hour old, without blocking the screen"] },
    { "dot": "violet", "title": "Cache first, stale over empty", "items": ["Each client checks its own 6h AsyncStorage cache before any network call, and serves it on failure", "Query retries are disabled — TideCheck's 50-request/day budget can't absorb them"] },
    { "dot": "emerald", "title": "Pure computation, thin UI", "items": ["Raw JSON becomes interpolating Series answering “value now” and “trend” by linear interpolation", "Wave/wind/rain is a non-essential overlay — its failure never blocks the tide UI", "WaterQualityClient never guesses 'clear': a failed or unrecognised EA response degrades to 'unknown', same rule tools/swim-card/src/beachQuality.mjs uses"] }
