      { "id": "resilience", "label": "Cache-first, stale over empty", "focus": ["tideClient", "waveClient", "waterQualityClient", "deviceStorage", "seriesInsights"], "note": "On a network error each client serves its last cache; retries are disabled to protect TideCheck's 50-request/day budget." },
      { "id": "waterQuality", "label": "Water quality fetch", "focus": ["useForecastData", "waterQualityClient", "deviceStorage", "eaBathingWaterAPI"], "note": "A third, independent query — its own 6h AsyncStorage cache, degrading to 'unknown' rather than blocking or guessing 'clear' on failure." },
      { "id": "widget-handoff", "label": "App → iOS widget hand-off", "focus": ["useWidgetSync", "widgetBridge", "secureKeyStore"], "note": "The widget can't show a text field, so the app pushes it config over a shared App Group on every key/location change." }
