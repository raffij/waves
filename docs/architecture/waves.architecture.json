  "cards": [
    { "dot": "cyan", "title": "Fetch", "items": ["All four clients read a key, then call TideCheck plus two Open-Meteo endpoints", "Expo and the xbar script cache to disk with a 6h TTL and fall back to stale data on failure", "The two widgets skip caching entirely — WidgetKit already throttles reloads to roughly hourly"] },
    { "dot": "violet", "title": "Diverge", "items": ["Expo persists multiple locations; the xbar script hardcodes one station; both widgets read whichever location their companion process last saved", "Expo renders native SVG charts; the xbar script prints ASCII bars; both widgets render native SwiftUI", "Key storage differs across all four: Keychain/localStorage, the macOS `security` CLI, and two App Group hand-offs", "Only Expo checks the EA's bathing-water classification for the selected location; the xbar script and both widgets don't"] },
    { "dot": "emerald", "title": "Own", "items": ["No shared package across any of the four clients", "Every duplicated fetch/parse behavior is a separate, hand-written implementation", "The iOS widget borrows its config from the Expo app it's attached to; the desktop widget gets its from its own tiny settings app — neither reuses the xbar script's Keychain-based key"] }
